# SEIC M&E Platform - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Backend Configuration
# ============================================

# Database
ConnectionStrings__DefaultConnection=Server=localhost;Database=SEICDatabase;User Id=sa;Password=YourPasswordHere;

# ASP.NET Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000

# ============================================
# Frontend Configuration
# ============================================

REACT_APP_API_URL=http://localhost:5000
REACT_APP_AUTH_ENABLED=true
REACT_APP_ENV=development

# ============================================
# Email Service (SendGrid)
# ============================================

SendGrid__ApiKey=SG.your-sendgrid-api-key-here
SendGrid__FromEmail=noreply@seic.pk
AppUrl=http://localhost:3000

# ============================================
# Authentication
# ============================================

# JWT Configuration
Jwt__Secret=your-super-secret-jwt-key-at-least-32-characters-long
Jwt__ExpirationMinutes=1440
Jwt__RefreshTokenExpirationDays=7

# ============================================
# Azure Configuration (for deployment)
# ============================================

AZURE_TENANT_ID=your-tenant-id
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure SQL
AZURE_SQL_SERVER=seic-sql-server.database.windows.net
AZURE_SQL_DATABASE=SEICDatabase
AZURE_SQL_USERNAME=seicadmin
AZURE_SQL_PASSWORD=your-sql-password

# Azure App Service
AZURE_APP_SERVICE_NAME=seic-me-platform
AZURE_RESOURCE_GROUP=rg-seic-platform

# ============================================
# Logging
# ============================================

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning

# ============================================
# CORS
# ============================================

CORS__AllowedOrigins=http://localhost:3000,https://seic-me-platform.azurewebsites.net
CORS__AllowedMethods=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS__AllowedHeaders=Content-Type,Authorization

# ============================================
# Features (Feature Flags)
# ============================================

Features__EnableEmailNotifications=true
Features__EnableAnonymousReporting=true
Features__EnableGrantTracking=true
Features__EnableHealthChecks=true

# ============================================
# Rate Limiting
# ============================================

RateLimiting__Enabled=true
RateLimiting__MaxRequests=100
RateLimiting__WindowSeconds=60

# ============================================
# Slack Integration (Optional)
# ============================================

Slack__WebhookUrl=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
Slack__Channel=#seic-notifications
Slack__EnableNotifications=false

# ============================================
# File Storage (Azure Blob or Local)
# ============================================

Storage__Type=AzureBlob
Storage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=...
Storage__ContainerName=seic-documents

# ============================================
# Admin Credentials (Initial Setup Only)
# ============================================

Admin__Email=admin@seic.pk
Admin__DefaultPassword=ChangeMe123!@#

# ============================================
# Cache Configuration
# ============================================

Cache__Type=Redis
Cache__ConnectionString=localhost:6379
Cache__DefaultExpirationMinutes=60
